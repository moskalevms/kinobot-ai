# .env.production
FLASK_ENV=production
FLASK_SECRET_KEY=my_key

# LLM API Keys
GIGACHAT_AUTH_KEY=my_key
GIGACHAT_BASE_URL=https://url

# Kinopoisk
KINOPOISK_API_KEY=my_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_MODE=polling

# Настройки приложения
MIN_VOTES_IMDB=5000
MIN_VOTES_KP=10000
CACHE_TTL=45

SSL_CERTIFICATE_PATH=/path/to/certificate.pem

LOG_LEVEL=INFO

# OMDb API — оценки Rotten Tomatoes (Epic B)
# Получить ключ: https://www.omdbapi.com/apikey.aspx
# ЛИЦЕНЗИОННОЕ РЕШЕНИЕ: данные OMDb (включая Rotten Tomatoes) распространяются
# под CC BY-NC 4.0 — ТОЛЬКО некоммерческое использование. Для MVP без
# монетизации это приемлемо; при коммерциализации лицензия RT стоит от ~$60k/год,
# поэтому фактически означает отказ от RT (достаточно ENABLE_RT_SCORES=false).
# Feature flag: RT-оценки активны только при ENABLE_RT_SCORES=true И непустом
# OMDB_API_KEY; пустой ключ и/или false полностью выключают Epic B.
OMDB_API_KEY=
ENABLE_RT_SCORES=false
