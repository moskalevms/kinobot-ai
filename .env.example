# .env.production
FLASK_ENV=production
FLASK_SECRET_KEY=my_key

# LLM API Keys
GIGACHAT_AUTH_KEY=my_key
GIGACHAT_BASE_URL=https://url

# Kinopoisk
KINOPOISK_API_KEY=my_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_MODE=polling

# Настройки приложения
MIN_VOTES_IMDB=5000
MIN_VOTES_KP=10000
CACHE_TTL=45

SSL_CERTIFICATE_PATH=/path/to/certificate.pem

LOG_LEVEL=INFO

# OMDb API — оценки Rotten Tomatoes (Epic B)
# Получить ключ: https://www.omdbapi.com/apikey.aspx
# ЛИЦЕНЗИОННОЕ РЕШЕНИЕ: данные OMDb (включая Rotten Tomatoes) распространяются
# под CC BY-NC 4.0 — ТОЛЬКО некоммерческое использование. Для MVP без
# монетизации это приемлемо; при коммерциализации лицензия RT стоит от ~$60k/год,
# поэтому фактически означает отказ от RT (достаточно ENABLE_RT_SCORES=false).
# Feature flag: RT-оценки активны только при ENABLE_RT_SCORES=true И непустом
# OMDB_API_KEY; пустой ключ и/или false полностью выключают Epic B.
OMDB_API_KEY=
ENABLE_RT_SCORES=false

# Кэш RT-оценок в PostgreSQL (таблица rt_scores, Epic B / задача B4).
# TTL записей кэша в днях; рекомендуемый диапазон 30–90, дефолт 60 — баланс
# свежести оценок и экономии квоты OMDb (free: 1000 запросов/день).
# Отрицательный кэш (фильмы без оценок) хранится с тем же TTL.
# Некорректное значение (нечисло, < 1) игнорируется в пользу дефолта;
# прочие значения применяются как есть (диапазон — рекомендация, не ограничение).
RT_CACHE_TTL_DAYS=60

# Пайплайн обогащения финальной выдачи RT-оценками (Epic B / задача B5).
# Обогащаются только финальные фильмы выдачи (не более limit, на практике ≤13),
# параллельно: RT_ENRICH_CONCURRENCY — число одновременных обращений
# (кэш + OMDb), рекомендуемый диапазон 3–5, дефолт 5 согласован с pool_size
# пула соединений кэша. Некорректное значение (нечисло, < 1) игнорируется
# в пользу дефолта.
RT_ENRICH_CONCURRENCY=5
# RT_ENRICH_DEADLINE_SECONDS — общий дедлайн обогащения одной выдачи в секундах:
# жёсткий потолок латентности (дефолт 4). По истечении дедлайна выдача
# возвращается без недостающих оценок — это защита от «зависшего» запроса к OMDb
# (его таймаут 8 с) и от блокирующего обращения к недоступному PostgreSQL.
# Некорректное значение (нечисло, ≤ 0) игнорируется в пользу дефолта.
RT_ENRICH_DEADLINE_SECONDS=4

